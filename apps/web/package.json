{
  "name": "@retirement/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && eslint apps/web/src/**/*.{ts,tsx}",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "VITEST_COVERAGE=1 vitest run --coverage --passWithNoTests",
    "test:bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@retirement/contracts": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "hash-wasm": "4.12.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-aria-components": "1.22.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "svg2pdf.js": "^2.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
