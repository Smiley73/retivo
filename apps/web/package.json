{
  "name": "@retirement/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "cd ../.. && eslint apps/web/src/**/*.{ts,tsx}",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "VITEST_COVERAGE=1 vitest run --coverage --passWithNoTests",
    "test:bridge": "vitest run --config vitest.bridge.config.ts",
    "test:bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@retirement/assistant-protocol": "workspace:*",
    "@retirement/contracts": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "hash-wasm": "4.13.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "svg2pdf.js": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1173.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "^4.14.1",
    "fake-indexeddb": "^6.2.8",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
