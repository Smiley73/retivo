    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "ksuid": "^3.0.0",
    "nestjs-pino": "^5.3.1",
    "otplib": "^13.4.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
