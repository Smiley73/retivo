    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@retirement/contracts": "workspace:*",
