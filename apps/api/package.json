{
  "name": "@retirement/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file=../../.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "build:lambda": "node scripts/build-lambda.mjs",
    "security:legacy-data-hygiene": "node scripts/security-retention-cleanup.mjs",
    "last-login-report": "node scripts/last-login-report.mjs",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && npx eslint apps/api/src/**/*.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
