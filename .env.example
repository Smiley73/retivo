# ─────────────────────────────────────────────────────────────
# Retivo — environment variables
# Copy to .env and adjust values. See docs/local-setup.md for setup.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# AWS region for the API's DynamoDB / S3 / SES / SSM clients. Ignored when
# the local emulator endpoints below are set.
AWS_REGION=us-east-1

# API listening port.
API_PORT=3001

# API bind host. `127.0.0.1` (loopback) keeps the dev API — which serves
# seeded dev-login credentials and dev token shortcuts — off your local
# network. Set `0.0.0.0` to expose it on the LAN.
#
# ⚠️  SECURITY: `0.0.0.0` exposes the dev API, including the seeded
# dev-login credentials, to every device on your local network. Only do
# this on a network you trust, and add the device's web origin to
# WEB_ALLOWED_ORIGINS below or cross-device login is rejected.
API_HOST=127.0.0.1

# Web dev-server bind host (read by apps/web/vite.config.ts). Same
# loopback default and LAN-exposure warning as API_HOST.
VITE_HOST=127.0.0.1

# Canonical web origin — the single URL used in generated signup-approval
# links. Include the scheme; no trailing slash.
WEB_ORIGIN=http://localhost:5173

# Comma-separated browser origins allowed to call state-changing endpoints
# (CORS, preflight, and the Origin/Referer check). Exact-match only — an
# origin not listed here is rejected. Unset ⇒ WEB_ORIGIN.
#
# To reach the dev app from another device on your LAN, add that device's
# web origin, e.g.:
#   WEB_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.42:5173
# (find your LAN IP with `ipconfig getifaddr en0` on macOS).
#
# The default pre-lists 5174/5175 and 5180–5189 so a second checkout that
# shares this API (see "second checkout" below) can log in without an
# edit + restart.
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183,http://localhost:5184,http://localhost:5185,http://localhost:5186,http://localhost:5187,http://localhost:5188,http://localhost:5189

# ─────────────────────────────────────────────────────────────
# Local emulator endpoints.
#
# When set, the API sends DynamoDB / S3 / SES traffic to the local Docker
# stack from `infrastructure/docker-compose.yml` (`pnpm emu:up`). Unset
# both to run the local API against real AWS through your AWS profile.
#
# EMU_*_HOST_PORT set the docker-compose host bindings; keep the
# *_ENDPOINT URLs pointing at the same ports. Moto defaults to 5001
# because macOS AirPlay Receiver squats on 5000.
# ─────────────────────────────────────────────────────────────
# Optional: prefix for docker image pulls (e.g. a private registry mirror).
# REGISTRY=myregistry.example.com/
EMU_DYNAMODB_HOST_PORT=8000
EMU_MOTO_HOST_PORT=5001
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:5001
# SES_ENDPOINT=http://localhost:5001

# ─────────────────────────────────────────────────────────────
# Auth signing keys (RS256).
#
# Two JSON maps keyed by the same `kid` set:
#   AUTH_JWT_PRIVATE_KEYS — { kid: pkcs8PrivateKeyPem }   // signs
#   AUTH_JWT_PUBLIC_KEYS  — { kid: spkiPublicKeyPem }     // verifies + JWKS
# On AWS these load from SSM Parameter Store at boot; the env vars are the
# local-dev fallback. Generate a pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#   openssl rsa -in priv.pem -pubout -out pub.pem
#   jq -n --arg kid "local-dev" --rawfile pem priv.pem '{($kid): $pem}' > priv.json
#   jq -n --arg kid "local-dev" --rawfile pem pub.pem  '{($kid): $pem}' > pub.json
# Paste each JSON file's contents as a single line (newlines escaped as \n).
# Tests mint ephemeral keys at startup; these are only needed for `pnpm dev`.
# ─────────────────────────────────────────────────────────────
AUTH_JWT_PRIVATE_KEYS={"local-dev":"replace-with-pkcs8-private-key-pem-json-encoded"}
AUTH_JWT_PUBLIC_KEYS={"local-dev":"replace-with-spki-public-key-pem-json-encoded"}
# Optional: which key signs new access tokens. Defaults to the first entry
# in AUTH_JWT_PRIVATE_KEYS.
# AUTH_JWT_CURRENT_KID=local-dev

# JWT issuer / audience. Every token the API signs — access, MFA challenge,
# data-export authorization — carries these as `iss`/`aud` and verification
# requires an exact match, so a token from one environment is invalid in
# another. Deployed stacks use `retivo-api/<stack>` / `retivo-web/<stack>`.
# Locally these default to the values below. Non-secret.
# AUTH_JWT_ISSUER=retivo-api/local
# AUTH_JWT_AUDIENCE=retivo-web/local

# Local-development shortcut. When 'true', /auth/signup and
# /auth/resend-verification return the raw verificationToken in the
# response so the signup page can offer a "verify now" link without SES
# delivery. Defaults to 'true' when NODE_ENV !== 'production' and 'false'
# on every deployed stack (dev and prod); a deployed stack refuses an
# explicit 'true' at boot.
EXPOSE_VERIFICATION_TOKEN=true
# Access-token TTL (minutes). Short on purpose: it forces a /auth/refresh
# within this window of any activity, which is how the server learns the
# user is still active and slides the idle window below.
AUTH_ACCESS_TOKEN_TTL_MIN=5
# Refresh-token TTL (minutes). Doubles as the idle-timeout window: after
# this many minutes without a successful refresh the session is signed
# out. Sliding — every refresh resets it to now + value.
AUTH_REFRESH_TOKEN_TTL_MIN=30

# Sender address for signup verification mail. Local dev with Moto accepts
# any address. On AWS the `retivo:sesFromAddress` stack config drives the
# live value; this is only the local fallback. SES sandbox mode (the
# default for new AWS accounts) requires the sender and every recipient to
# be verified with `aws sesv2 create-email-identity` — bootstrap-stack.sh
# triggers that for the sender. Deployed stacks have no shortcut around
# mail delivery: signup there completes only once mail actually delivers.
SES_FROM_ADDRESS=no-reply@example.invalid

# Optional: owner inbox that receives a signup-approval mail when somebody
# other than the owner signs up. Kept separate from SES_FROM_ADDRESS so a
# no-reply sender doesn't swallow approval mail. Unset ⇒ falls back to
# SES_FROM_ADDRESS (local dev only — deployed stacks set it from
# `retivo:approverEmail`).
# APPROVER_EMAIL=owner@example.com

# Optional: disable the global rate limiter (e.g. for load tests or the e2e
# suite). Refused at boot when NODE_ENV=production.
# DISABLE_THROTTLE=true

# Optional: run the wall-clock performance assertions in monte-carlo.test.ts.
# PERF_ASSERT=1

# Optional: pino log level.
# LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Resource names.
#
# On AWS Pulumi sets these from the stack's `namePrefix`. Locally the API
# defaults to `retirement-local-<table>`, matching the emulator tables the
# test bootstrap creates. Override only for a non-default table layout.
# ─────────────────────────────────────────────────────────────
# TABLE_WORKSPACE_META=retirement-local-workspace-meta
# TABLE_MUTATION_LOG=retirement-local-mutation-log
# TABLE_AGGREGATE_VERSION=retirement-local-aggregate-version
# TABLE_IDEMPOTENCY_KEY=retirement-local-idempotency-key
# TABLE_DEVICE_REGISTRY=retirement-local-device-registry
# TABLE_USER=retirement-local-user
# TABLE_EMAIL_RESERVATION=retirement-local-email-reservation
# TABLE_EMAIL_VERIFICATION=retirement-local-email-verification
# TABLE_PASSWORD_RESET=retirement-local-password-reset
# TABLE_CREDENTIAL=retirement-local-credential
# TABLE_PASSKEY=retirement-local-passkey
# TABLE_REFRESH_TOKEN=retirement-local-refresh-token
# TABLE_REVOKED_TOKEN=retirement-local-revoked-token
# TABLE_FAILED_LOGIN_ATTEMPT=retirement-local-failed-login-attempt
# TABLE_AUTH_EVENT=retirement-local-auth-event
# TABLE_SIGNUP_APPROVAL=retirement-local-signup-approval
# TABLE_HOUSEHOLD_KEY_ENVELOPE=retirement-local-household-key-envelope
# Second-factor (MFA) tables. user-mfa: TOTP enrollment state.
# mfa-email-otp: live email-OTP code hash (~10-min TTL). trusted-device:
# per-device MFA-skip trust (~30-day TTL).
# TABLE_USER_MFA=retirement-local-user-mfa
# TABLE_MFA_EMAIL_OTP=retirement-local-mfa-email-otp
# TABLE_TRUSTED_DEVICE=retirement-local-trusted-device
# Single-use WebAuthn challenges (~5-min TTL), shared across API instances
# so a challenge minted on one instance can be consumed on another.
# TABLE_PASSKEY_CHALLENGE=retirement-local-passkey-challenge
# Second-factor gate. When 'true', a password login on a new/untrusted
# device returns an MFA challenge instead of a session. Deployed stacks
# set it from the `retivo:authMfaEnforced` stack config (default true).
# The code default is 'false', so local dev stays password-only unless you
# set 'true' here to exercise the enforced flow.
# AUTH_MFA_ENFORCED=false
# SNAPSHOTS_BUCKET=retirement-local-snapshots

# Name of the account-deletion snapshot-purge Lambda. On AWS Pulumi injects
# it into the api Lambda, and DELETE /auth/account invokes it to purge the
# household's S3 snapshots (the api role has no bucket-wide delete). Leave
# UNSET locally: with no STACK set the API purges in-process, so `pnpm dev`
# and the emulator test suite need no deployed Lambda. On a deployed stack
# (STACK set) the API fails boot if this is missing.
# SNAPSHOT_PURGE_FUNCTION_NAME=retivo-dev-snapshot-purge

# Snapshot janitor retention (apps/api/src/janitor/janitor.service.ts). On
# AWS these come from the `retivo:snapshotMinKeep` / `retivo:snapshotMinAgeDays`
# stack config. Rarely needed locally — the janitor doesn't run from `pnpm dev`.
# SNAPSHOT_MIN_KEEP=10
# SNAPSHOT_MIN_AGE_DAYS=90

# ─────────────────────────────────────────────────────────────
# Web build-time config. Resolved by Vite and baked into the bundle.
#
# Leave VITE_API_BASE_URL BLANK for local dev: the SPA derives the API base
# from the browser host — `http://localhost:3001` on localhost,
# `http://<lan-ip>:3001` on a LAN device — so it always calls the host it
# loaded from. Set an explicit value to override (non-default API port, or
# pinning a host). Production builds inject `""` so the SPA uses relative
# URLs against its own origin (CloudFront `/api/*`).
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=

# Web-client idle timeout (minutes). After this long without user input or
# a visibility change the SPA signs out and the login page shows a one-time
# "Signed out due to inactivity" toast. 0 disables it. Server-side idle
# enforcement is separate (AUTH_REFRESH_TOKEN_TTL_MIN).
VITE_IDLE_TIMEOUT_MIN=30
# Lead time (minutes) before the idle timeout at which the warning modal
# ("You'll be signed out in N minutes…") appears.
VITE_IDLE_WARN_LEAD_MIN=2

# ─────────────────────────────────────────────────────────────
# Optional: run a SECOND checkout on alternate ports.
#
# The defaults (API :3001, web :5173) collide when `pnpm dev` runs in two
# checkouts at once (e.g. a worktree beside the primary repo). Override
# the FULL tuple — changing only the ports leaves the web app pointed at
# the wrong API and CORS rejecting it. `VITE_PORT` is read by
# apps/web/vite.config.ts (unset ⇒ 5173). VITE_API_BASE_URL must be set
# explicitly because the blank-default derivation assumes :3001.
# Example for web :5273 / API :3101:
#   VITE_PORT=5273
#   API_PORT=3101
#   VITE_API_BASE_URL=http://localhost:3101
#   WEB_ORIGIN=http://localhost:5273
#   WEB_ALLOWED_ORIGINS=http://localhost:5273
# VITE_PORT=5173

# Beta features this build OFFERS (baked into the SPA bundle; read by
# apps/web/src/lib/feature-flags.ts). `all` (default when unset or blank)
# offers every feature currently marked Beta, `none` offers none, or list
# feature ids comma-separated — today:
#   projected-withdrawals, guardrails
# An offered beta feature stays hidden until the person switches on "Show
# beta features" under Settings → Preferences. Deployed stacks set this
# from the `retivo:betaFeatures` stack config.
# VITE_BETA_FEATURES=all

# AI assistant connector: the loopback port of the local bridge, baked into
# the SPA bundle. Unset or blank = connector off. The Vite dev server sends no
# CSP, so a local build needs only this variable. Deployed stacks set it from
# the `retivo:assistantBridgePort` stack config, which also adds the one
# matching `ws://127.0.0.1:<port>` entry to the CloudFront CSP.
# VITE_ASSISTANT_BRIDGE_PORT=24580

# Browser-only mode: the SPA never calls the sync API and IndexedDB is the
# only persistence. Useful for offline UX work without an API running.
# VITE_SYNC_MOCK=true

# Build fingerprint baked into the SPA bundle (`__BUILD_ID__`) and echoed
# by the api Lambda on every response (`X-Build-Id`). The detector in
# apps/web/src/lib/build-id.ts compares them and shows the "new version
# available" reload banner on mismatch. Only meaningful at build/deploy
# time — the deploy scripts derive one from the git sha + UTC timestamp and
# export it to both the SPA build (`VITE_BUILD_ID`) and `pulumi up`
# (`BUILD_ID` → Lambda env). Local dev defaults to `dev`, which the
# detector treats as "never mismatch"; set these only to exercise the
# banner. A production API (NODE_ENV=production) refuses to start with
# BUILD_ID still `dev`, because legal-document records store the build id
# as permanent provenance — deploy through the scripts, never a bare
# `pulumi up`.
# BUILD_ID=
# VITE_BUILD_ID=

# Deploy-time escape hatch for the schema-ahead preflight
# (scripts/check-schema-not-ahead.mjs, run by
# infrastructure/scripts/deploy-stack.sh). The deploy refuses a tree whose
# aggregate schema versions are ahead of origin/main, because rows written
# at a version no shipped bundle carries halt that workspace's sync
# permanently. Set it to 1 ONLY for the one deploy that really carries the
# next schema version, and ONLY on the command line:
#   ALLOW_SCHEMA_AHEAD=1 ./infrastructure/scripts/deploy-stack.sh dev
# ⚠️  Never export it from your shell profile — deploy-stack.sh reads it
# from the invoking environment, so a profile export arms the override for
# every deploy. A line in `infrastructure/.deploy.env` does NOT arm it
# (that file is sourced after the value is captured). Whenever the
# override is armed, the deploy log says so before the preflight runs.
# ALLOW_SCHEMA_AHEAD=1
