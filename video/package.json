{
  "name": "retivo-videos",
  "private": true,
  "description": "Product videos for Retivo, made with Remotion",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "kit",
    "template"
  ],
  "scripts": {
    "new": "node scripts/new-video.mjs",
    "test": "node --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "lint": "eslint scripts && npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.3.0",
    "@types/web": "0.0.358",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
