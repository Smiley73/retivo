.claude/scheduled_tasks*

# Pulumi per-stack configs hold a per-machine encryptionsalt and
# user-specific values (sesFromAddress, webOrigin). Tracked as
# Pulumi.<stack>.yaml.example; copy to Pulumi.<stack>.yaml locally.
infrastructure/Pulumi.*.yaml
!infrastructure/Pulumi.*.yaml.example

# Impeccable design-tool per-developer scratch: critique snapshots and
# UI-verification screenshots are local artifacts (the shared config —
# .impeccable/design.json and .impeccable/live/ — stays tracked).
.impeccable/critique/
.impeccable/screenshots/

# Playwright MCP browser session logs + accessibility snapshots (transient).
.playwright-mcp/

# tagteam cross-engine plan/PR-train workflow runtime state, plus the CodeGraph
