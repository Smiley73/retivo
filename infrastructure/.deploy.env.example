# Local, gitignored deploy convenience config sourced by
# scripts/bootstrap-stack.sh (and safe to `source` yourself before
# scripts/deploy-stack.sh). Copy to `.deploy.env` — though you usually
# don't need to: the bootstrap script auto-creates `.deploy.env` with a
# derived PULUMI_BACKEND_URL on first run, then `pulumi login`s to it.

# Self-managed S3 state backend. Same value for both stacks (it's per
# AWS account, not per stack). Left unset, bootstrap-stack.sh derives it
# as s3://retivo-pulumi-state-<account-id>?region=<the stack's aws:region>
# and creates that bucket on first run. A file left over from another
# AWS account names a bucket this account cannot own: delete it.
PULUMI_BACKEND_URL=s3://retivo-pulumi-state-<account-id>?region=us-east-1

# Optional: cache a Pulumi passphrase here to skip the SSM fetch.
# Recommended to leave this commented — bootstrap-stack.sh creates the
# correct PER-STACK passphrase at /retivo-pulumi/<stack>/passphrase in SSM
# on first run and fetches it from there afterwards, which a single cached
# value here cannot do (dev and prod have different passphrases). A value set
# here counts as an exported passphrase: bootstrap uses it as given and
# stores nothing in SSM. Only set it if you deploy one stack and want to
# avoid the SSM round-trip.
# PULUMI_CONFIG_PASSPHRASE=...
